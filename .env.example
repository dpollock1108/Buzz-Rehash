ANTHROPIC_API_KEY=your-api-key-here
PORT=3001
DATABASE_PATH=./server/data/buzz-rehash.db

# --- Auth ---
# Secret used to sign session cookies (required in production)
SESSION_SECRET=change-me

# SSO via any OIDC provider (Google, Auth0, Okta, Clerk...).
# Leave unset to use dev login only.
# Google example:
#   OIDC_ISSUER=https://accounts.google.com
#   Create OAuth credentials at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:5173/api/auth/callback (dev, via Vite proxy)
#OIDC_ISSUER=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# Public base URL used to build the OIDC redirect URI (set in production)
#APP_BASE_URL=http://localhost:5173

# Comma-separated emails that get the admin role when signing in via SSO
#ADMIN_EMAILS=you@example.com

# Dev login is enabled automatically outside production; set to true to force-enable
#ALLOW_DEV_LOGIN=true
